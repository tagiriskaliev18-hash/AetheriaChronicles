# Auto-detect text vs binary and keep LF for scripts/shaders/YAML
* text=auto

*.cs     text eol=lf
*.shader text eol=lf
*.hlsl   text eol=lf
*.cginc  text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.asset  text eol=lf
# Binary-serialized Unity assets: text normalisation corrupts them (CR LF bytes inside binary data).
Assets/Generated/AetheriaTerrainData.asset binary
*.terraindata binary
ProjectSettings/XRSettings.asset binary
*.mat    text eol=lf
*.prefab text eol=lf
*.unity  text eol=lf

*.png    binary
*.jpg    binary
*.tga    binary
*.ogg    binary
*.wav    binary
*.glb    binary
*.gltf   text eol=lf
*.bin    binary
*.fbx    binary
*.ttf    binary
*.otf    binary
